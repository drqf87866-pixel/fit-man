{
  "name": "fit-man",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first Fitness- & Workout-Tracker auf Cloudflare Workers (Hono + D1 + Drizzle)",
  "scripts": {
    "dev": "npm run build:css && wrangler dev",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/app.css -o ./public/styles.css --watch",
    "deploy": "npm run build:css && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fit-man-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fit-man-db --remote",
    "db:seed:local": "wrangler d1 execute fit-man-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute fit-man-db --remote --file=./seed.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@tailwindcss/cli": "^4.1.11",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "wrangler": "^4.28.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true,
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.15.18": true,
    "es5-ext@0.10.64": true
  }
}
